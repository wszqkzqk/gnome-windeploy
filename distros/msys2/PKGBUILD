# Maintainer: wszqkzqk <wszqkzqk@qq.com>

_realname=gnome-windeploy
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.1.0
pkgrel=1
pkgdesc="Deployment tool for GNOME-platform desktop apps on Windows (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/wszqkzqk/${_realname}"
license=('spdx:GPL-2.0-or-later')
depends=(
    "${MINGW_PACKAGE_PREFIX}-python"
    "${MINGW_PACKAGE_PREFIX}-python-pefile"
)
makedepends=(
    "git"
    "${MINGW_PACKAGE_PREFIX}-python-build"
    "${MINGW_PACKAGE_PREFIX}-python-hatchling"
    "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
    "${MINGW_PACKAGE_PREFIX}-gcc"
    "${MINGW_PACKAGE_PREFIX}-gstreamer"
    "${MINGW_PACKAGE_PREFIX}-gtk4"
    "${MINGW_PACKAGE_PREFIX}-pkgconf"
    "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
source=("${_realname}::git+file://${startdir}/../..")
sha256sums=('SKIP')

pkgver() {
    cd ${_realname}
    _version=$(git describe --tags --abbrev=12 2>/dev/null | sed 's/^v//;s/-/./g')
    if [ -z "$_version" ]; then
        _version="0.1.0"
    fi
    echo "$_version"
}

build() {
  cd ${_realname}
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd ${_realname}
  GNOME_WINDEPLOY_TEST_PREFIX="${MINGW_PREFIX}" \
  PYTHONPATH="${srcdir}/${_realname}/src" \
    ${MINGW_PREFIX}/bin/python -m pytest -q
}

package() {
  cd ${_realname}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
